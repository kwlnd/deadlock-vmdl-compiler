<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>DeadlockVmdlCompiler.Tests</RootNamespace>
    <!-- The app methods take an optional token; tests have nothing to cancel. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../DeadlockVmdlCompiler.csproj" />
    <EmbeddedResource Include="NeutralAg2Models.json" LogicalName="NeutralAg2Models.json" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
