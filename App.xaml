<Application x:Class="DeadlockVmdlCompiler.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <!-- Pure Monochrome / Grayscale Palette (Zero Blue, Zero Green) -->
        <SolidColorBrush x:Key="AppBg" Color="#1E1F22"/>
        <SolidColorBrush x:Key="CardBg" Color="#2B2D31"/>
        <SolidColorBrush x:Key="CardBorder" Color="#383A40"/>
        <SolidColorBrush x:Key="CardHoverBorder" Color="#4A4D55"/>
        <SolidColorBrush x:Key="InputBg" Color="#18191C"/>
        <SolidColorBrush x:Key="InputBorder" Color="#3F4248"/>
        <SolidColorBrush x:Key="InputBorderHover" Color="#555A62"/>
        <SolidColorBrush x:Key="InputBorderFocus" Color="#727782"/>
        <SolidColorBrush x:Key="ViewportBg" Color="#121315"/>
        <SolidColorBrush x:Key="RowDivider" Color="#33353B"/>

        <!-- Text Colors (Pure Neutral White / Gray) -->
        <SolidColorBrush x:Key="TextPrimary" Color="#EDEDED"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A4AB"/>
        <SolidColorBrush x:Key="TextMuted" Color="#7A7E86"/>
        <SolidColorBrush x:Key="TextDisabled" Color="#50535A"/>
        <SolidColorBrush x:Key="StatusNeutral" Color="#C0C4CC"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#619BF2"/>
        <SolidColorBrush x:Key="AccentBlueLight" Color="#87B4F9"/>

        <!-- Button Palette (Neutral Charcoal / Slate Gray) -->
        <SolidColorBrush x:Key="BtnSecBg" Color="#35373C"/>
        <SolidColorBrush x:Key="BtnSecBorder" Color="#44474E"/>
        <SolidColorBrush x:Key="BtnSecHover" Color="#42454C"/>
        <SolidColorBrush x:Key="BtnPrimaryBg" Color="#484C55"/>
        <SolidColorBrush x:Key="BtnPrimaryBorder" Color="#5A5F6B"/>
        <SolidColorBrush x:Key="BtnPrimaryHover" Color="#585D68"/>
        <SolidColorBrush x:Key="BtnPrimaryPressed" Color="#3A3D44"/>

        <!-- Scrollbar Colors -->
        <SolidColorBrush x:Key="ScrollBarTrack" Color="#18191C"/>
        <SolidColorBrush x:Key="ScrollBarThumb" Color="#3E4249"/>
        <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#555A63"/>

        <!-- Global Typography -->
        <FontFamily x:Key="MainFont">Segoe UI, sans-serif</FontFamily>
        <FontFamily x:Key="CodeFont">Consolas, monospace</FontFamily>

        <!-- Custom Dark ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource ScrollBarTrack}"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource ScrollBarThumb}" CornerRadius="2" Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource ScrollBarThumbHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panel Card Style -->
        <Style x:Key="StudioCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>

        <!-- Item Title Style -->
        <Style x:Key="ItemTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="ItemDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>

        <!-- ModelDoc TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource InputBorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource InputBorderFocus}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="StudioSecBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BtnSecBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BtnSecBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BtnSecHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource InputBorderFocus}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BtnPrimaryPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource InputBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (Compile) -->
        <Style x:Key="StudioPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BtnPrimaryBg}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BtnPrimaryBorder}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BtnPrimaryHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource InputBorderFocus}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BtnPrimaryPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BtnSecBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Item Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BtnSecHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BtnPrimaryBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style with Full Support for Editable ComboBoxes -->
        <ControlTemplate x:Key="ComboBoxTextBoxTemplate" TargetType="TextBox">
            <Border x:Name="border"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid">
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateBox"
                                                Background="{StaticResource InputBg}"
                                                BorderBrush="{StaticResource InputBorder}"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Padding="6,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Grid.Column="1" Width="8" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="8" Height="6">
                                                        <Path x:Name="Arrow" Data="M 0 1 L 4 5 L 8 1" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="templateBox" Property="BorderBrush" Value="{StaticResource InputBorderHover}"/>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="#619BF2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Non-Editable Display -->
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,2,24,2"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <!-- Editable TextBox (Crucial for IsEditable="True") -->
                            <TextBox x:Name="PART_EditableTextBox"
                                     Template="{StaticResource ComboBoxTextBoxTemplate}"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextPrimary}"
                                     CaretBrush="{StaticResource TextPrimary}"
                                     BorderThickness="0"
                                     Margin="6,2,24,2"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Visibility="Collapsed"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Grid x:Name="DropDown"
                                      MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                      MaxHeight="260">
                                    <Border x:Name="DropDownBorder"
                                            Background="{StaticResource CardBg}"
                                            BorderBrush="{StaticResource CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Padding="2"
                                            Margin="0,2,0,0">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="true">
                                <Setter Property="IsTabStop" Value="false"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Flat Dark CheckBox Style (Centered Crisp Vector) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,3,10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Border x:Name="BulletBorder"
                                        Width="15"
                                        Height="15"
                                        Background="{StaticResource InputBg}"
                                        BorderBrush="{StaticResource InputBorder}"
                                        BorderThickness="1.2"
                                        CornerRadius="3"
                                        VerticalAlignment="Center">
                                    <Viewbox x:Name="CheckIcon" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                        <Canvas Width="16" Height="16">
                                            <Path x:Name="CheckPath"
                                                  Data="M 2.5 8.5 L 6 12 L 13.5 4.5"
                                                  Stroke="#619BF2"
                                                  StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BulletBorder" Property="BorderBrush" Value="{StaticResource InputBorderHover}"/>
                                <Setter TargetName="BulletBorder" Property="Background" Value="{StaticResource CardBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="BulletBorder" Property="BorderBrush" Value="#619BF2"/>
                                <Setter TargetName="BulletBorder" Property="Background" Value="#1E2A40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BulletBorder" Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                                <Setter TargetName="BulletBorder" Property="Background" Value="{StaticResource InputBg}"/>
                                <Setter TargetName="CheckPath" Property="Stroke" Value="{StaticResource TextDisabled}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Flat Dark Expander Style (Crisp Chevron + White Text) -->
        <ControlTemplate x:Key="ExpanderToggleButtonTemplate" TargetType="ToggleButton">
            <Border Background="Transparent" Padding="2,4" Cursor="Hand">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="16" Height="16" Background="{StaticResource BtnSecBg}" BorderBrush="{StaticResource BtnSecBorder}" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0">
                        <Viewbox Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="16" Height="16">
                                <Path x:Name="Chevron"
                                      Data="M 5 3 L 11 8 L 5 13"
                                      Stroke="{StaticResource TextSecondary}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{StaticResource TextPrimary}" TextElement.FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chevron" Property="Stroke" Value="#619BF2"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Chevron" Property="Data" Value="M 3 5 L 8 11 L 13 5"/>
                    <Setter TargetName="Chevron" Property="Stroke" Value="#619BF2"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          Template="{StaticResource ExpanderToggleButtonTemplate}"
                                          Focusable="False"
                                          Foreground="{StaticResource TextPrimary}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ContentPresenter ContentSource="Header" TextElement.Foreground="{StaticResource TextPrimary}"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              DockPanel.Dock="Bottom"
                                              Visibility="Collapsed"
                                              Focusable="False"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
