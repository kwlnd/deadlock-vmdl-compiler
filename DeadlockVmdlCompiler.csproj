<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeadlockVmdlCompiler</RootNamespace>
    <AssemblyName>DeadlockVmdlCompiler</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <Product>Deadlock AG2 Compiler</Product>
    <AssemblyTitle>Deadlock AG2 Compiler</AssemblyTitle>
    <Description>Deadlock AnimGraph2 nodes injection and compilation tool</Description>
    <Version>1.5.3</Version>
    <AssemblyVersion>1.5.3</AssemblyVersion>
    <FileVersion>1.5.3</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="AppIcon.ico" />
    <AvaloniaResource Include="AppIcon.png" />
    <AvaloniaResource Include="Assets/npc/*.png" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="scratch/**/*.cs" />
    <AvaloniaXaml Remove="tests/**;scratch/**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="hero_paths.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <!-- 11.3.13+ crash when an AutoCompleteBox item is picked (add addon hero list); pin the patched DBus. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="ValveKeyValue" Version="0.71.0.528" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    <PackageReference Include="ValvePak" Version="6.0.0.182" />
    <PackageReference Include="ValveResourceFormat" Version="[20.2.0-master.aab066c]" />
  </ItemGroup>

  <Target Name="RemovePublishedDebugSymbols" AfterTargets="Publish">
    <ItemGroup>
      <PublishedDebugSymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedDebugSymbols)" />
  </Target>

</Project>

