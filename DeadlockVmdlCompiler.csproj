<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeadlockVmdlCompiler</RootNamespace>
    <AssemblyName>DeadlockVmdlCompiler</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <Product>Deadlock AG2 Compiler</Product>
    <AssemblyTitle>Deadlock AG2 Compiler</AssemblyTitle>
    <Description>Deadlock AnimGraph2 nodes injection and compilation tool</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="AppIcon.ico" />
    <Resource Include="AppIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="hero_paths.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ValveKeyValue" Version="0.70.0.499" />
    <PackageReference Include="ValveResourceFormat" Version="20.0.6980" />
  </ItemGroup>

</Project>
