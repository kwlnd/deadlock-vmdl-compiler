<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeadlockVmdlCompiler</RootNamespace>
    <AssemblyName>DeadlockVmdlCompiler</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <Product>Deadlock AG2 Compiler</Product>
    <AssemblyTitle>Deadlock AG2 Compiler</AssemblyTitle>
    <Description>Deadlock AnimGraph2 nodes injection and compilation tool</Description>
    <Version>1.3.7</Version>
    <AssemblyVersion>1.3.7</AssemblyVersion>
    <FileVersion>1.3.7</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="AppIcon.ico" />
    <AvaloniaResource Include="AppIcon.png" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="scratch/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="hero_paths.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
    <PackageReference Include="ValveKeyValue" Version="0.70.0.499" />
    <PackageReference Include="ValvePak" Version="4.0.0.142" />
    <PackageReference Include="ValveResourceFormat" Version="[20.0.7151-vcs72.1]" />
  </ItemGroup>

  <Target Name="RemovePublishedDebugSymbols" AfterTargets="Publish">
    <ItemGroup>
      <PublishedDebugSymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedDebugSymbols)" />
  </Target>

</Project>
