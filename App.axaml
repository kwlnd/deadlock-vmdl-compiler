<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeadlockVmdlCompiler.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- The existing studio palette, shared by the workspace and its dialogs. -->
        <SolidColorBrush x:Key="StudioWindow" Color="#11151D"/>
        <SolidColorBrush x:Key="StudioPanel" Color="#1A2230"/>
        <SolidColorBrush x:Key="StudioInput" Color="#131822"/>
        <SolidColorBrush x:Key="StudioViewport" Color="#0E1219"/>
        <SolidColorBrush x:Key="StudioBorder" Color="#2D394E"/>
        <SolidColorBrush x:Key="StudioBorderStrong" Color="#3B4B64"/>
        <SolidColorBrush x:Key="StudioText" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="StudioTextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="StudioTextSoft" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="StudioAccent" Color="#60A5FA"/>
        <SolidColorBrush x:Key="StudioPortrait" Color="#263247"/>
        <SolidColorBrush x:Key="StudioPrimary" Color="#255899"/>
        <SolidColorBrush x:Key="AutoCompleteBoxSuggestionsListBackground" Color="#1A2230"/>
        <SolidColorBrush x:Key="AutoCompleteBoxSuggestionsListBorderBrush" Color="#3B4B64"/>
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1A2230"/>
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#3B4B64"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#263247"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#255899"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#306CB5"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#1C4578"/>

        <!-- One icon set for the whole app: 24px grid, round 2px strokes. -->
        <StreamGeometry x:Key="IconPlus">M5 12h14 M12 5v14</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M3 12a9 9 0 0 1 9 -9a9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1 -9 9a9.75 9.75 0 0 1 -6.74 -2.74L3 16 M8 16H3v5</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M20 20a2 2 0 0 0 2 -2V8a2 2 0 0 0 -2 -2h-7.9a2 2 0 0 1 -1.69 -0.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0 -2 2v13a2 2 0 0 0 2 2Z</StreamGeometry>
        <StreamGeometry x:Key="IconFolderOpen">M6 14l1.5 -2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1 -1.95 1.5H4a2 2 0 0 1 -2 -2V5a2 2 0 0 1 2 -2h3.9a2 2 0 0 1 1.69 0.9l0.81 1.2a2 2 0 0 0 1.67 0.9H18a2 2 0 0 1 2 2v2</StreamGeometry>
        <StreamGeometry x:Key="IconBox">M21 8a2 2 0 0 0 -1 -1.73l-7 -4a2 2 0 0 0 -2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7 -4A2 2 0 0 0 21 16Z M3.3 7L12 12l8.7 -5 M12 22V12</StreamGeometry>
        <StreamGeometry x:Key="IconPlay">M6 4.5v15a1 1 0 0 0 1.54 0.84l11.5 -7.5a1 1 0 0 0 0 -1.68L7.54 3.66A1 1 0 0 0 6 4.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconArchive">M3 4h18a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1H3a1 1 0 0 1 -1 -1V5a1 1 0 0 1 1 -1Z M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2V8 M10 12h4</StreamGeometry>
        <StreamGeometry x:Key="IconGamepad">M6 11h4 M8 9v4 M15 12h0.01 M18 10h0.01 M17.32 5H6.68a4 4 0 0 0 -3.978 3.59c-0.006 0.052 -0.01 0.101 -0.017 0.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5 -0.5 2 -1l1.414 -1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414 0.586L17 18c0.5 0.5 1 1 2 1a3 3 0 0 0 3 -3c0 -1.545 -0.604 -6.584 -0.685 -7.258c-0.007 -0.05 -0.011 -0.1 -0.017 -0.151A4 4 0 0 0 17.32 5Z</StreamGeometry>
        <StreamGeometry x:Key="IconWrench">M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77 -3.77a6 6 0 0 1 -7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1 -3 -3l6.91 -6.91a6 6 0 0 1 7.94 -7.94l-3.76 3.76Z</StreamGeometry>
        <StreamGeometry x:Key="IconUpload">M21 15v4a2 2 0 0 1 -2 2H5a2 2 0 0 1 -2 -2v-4 M17 8l-5 -5l-5 5 M12 3v12</StreamGeometry>
        <StreamGeometry x:Key="IconSliders">M21 4h-7 M10 4H3 M21 12h-9 M8 12H3 M21 20h-5 M12 20H3 M14 2v4 M8 10v4 M16 18v4</StreamGeometry>
        <StreamGeometry x:Key="IconChevronDown">M6 9l6 6l6 -6</StreamGeometry>
        <StreamGeometry x:Key="IconChevronUp">M18 15l-6 -6l-6 6</StreamGeometry>
        <StreamGeometry x:Key="IconTrash">M3 6h18 M19 6v14a2 2 0 0 1 -2 2H7a2 2 0 0 1 -2 -2V6 M8 6V4a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6</StreamGeometry>
        <StreamGeometry x:Key="IconCopy">M10 8h10a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2H10a2 2 0 0 1 -2 -2V10a2 2 0 0 1 2 -2Z M4 16a2 2 0 0 1 -2 -2V4a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2</StreamGeometry>
        <StreamGeometry x:Key="IconList">M8 6h13 M8 12h13 M8 18h13 M3 6h0.01 M3 12h0.01 M3 18h0.01</StreamGeometry>
        <StreamGeometry x:Key="IconUndo">M3 12a9 9 0 1 0 9 -9a9.75 9.75 0 0 0 -6.74 2.74L3 8 M3 3v5h5</StreamGeometry>
        <StreamGeometry x:Key="IconFrame">M8 3H5a2 2 0 0 0 -2 2v3 M21 8V5a2 2 0 0 0 -2 -2h-3 M3 16v3a2 2 0 0 0 2 2h3 M16 21h3a2 2 0 0 0 2 -2v-3</StreamGeometry>
        <StreamGeometry x:Key="IconAlert">M21.73 18l-8 -14a2 2 0 0 0 -3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73 -3Z M12 9v4 M12 17h0.01</StreamGeometry>
        <StreamGeometry x:Key="IconLayers">M12.83 2.18a2 2 0 0 0 -1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58 -3.9a1 1 0 0 0 0 -1.83Z M2 12a1 1 0 0 0 0.58 0.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58 -3.9A1 1 0 0 0 22 12 M2 17a1 1 0 0 0 0.58 0.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58 -3.9A1 1 0 0 0 22 17</StreamGeometry>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />

        <!-- Shared type and surface hierarchy. -->
        <Style Selector="Border.studio-card">
            <Setter Property="Background" Value="{StaticResource StudioPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StudioBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Border.studio-inset">
            <Setter Property="Background" Value="{StaticResource StudioInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StudioBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource StudioTextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource StudioText}"/>
        </Style>
        <Style Selector="TextBlock.field-hint">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource StudioTextMuted}"/>
        </Style>
        <Style Selector="TextBlock.body-copy">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource StudioTextSoft}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Icons take the accent colour, white on primary buttons, and dim with a disabled button. -->
        <Style Selector="Path.icon">
            <Setter Property="Stroke" Value="{StaticResource StudioAccent}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
        </Style>
        <Style Selector="Path.icon.muted">
            <Setter Property="Stroke" Value="{StaticResource StudioTextMuted}"/>
        </Style>
        <Style Selector="Path.icon.warning">
            <Setter Property="Stroke" Value="#FBBF24"/>
        </Style>
        <Style Selector="Button.primary Path.icon">
            <Setter Property="Stroke" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Path.icon.solid">
            <Setter Property="Fill" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button:disabled Path.icon">
            <Setter Property="Stroke" Value="#555E6D"/>
        </Style>
        <Style Selector="Button:disabled Path.icon.solid">
            <Setter Property="Fill" Value="#555E6D"/>
        </Style>

        <!-- Global Studio Styling -->
        
        <!-- Standard Action Button -->
        <Style Selector="Button">
            <Setter Property="Background" Value="#212A3B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#324058" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2B384F" />
            <Setter Property="BorderBrush" Value="#465775" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#171D29" />
            <Setter Property="BorderBrush" Value="#273347" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#151A24" />
            <Setter Property="BorderBrush" Value="#202736" />
            <Setter Property="Foreground" Value="#555E6D" />
        </Style>

        <!-- Primary Accent Button (Compile) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#255899" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3D7BC9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#306CB5" />
            <Setter Property="BorderBrush" Value="#5795E6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C4578" />
        </Style>
        <Style Selector="Button.utility">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.subtle-toggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.subtle-toggle:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- TextBox -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#131822" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#2D384D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#60A5FA" />
            <Setter Property="Background" Value="#171D2A" />
        </Style>

        <!-- ComboBox -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#131822" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#2D384D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="#19202E" />
            <Setter Property="BorderBrush" Value="#41506B" />
        </Style>

        <Style Selector="AutoCompleteBox">
            <Setter Property="Background" Value="{StaticResource StudioInput}"/>
            <Setter Property="Foreground" Value="{StaticResource StudioText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StudioBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{StaticResource StudioPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StudioBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource StudioText}"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource StudioPortrait}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource StudioPrimary}"/>
        </Style>

        <!-- CheckBox -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="CheckBox /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="#131822" />
            <Setter Property="BorderBrush" Value="#2D384D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="#60A5FA" />
            <Setter Property="Background" Value="#1A2230" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="#255899" />
            <Setter Property="BorderBrush" Value="#60A5FA" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="#FFFFFF" />
            <Setter Property="Stroke" Value="#FFFFFF" />
        </Style>
    </Application.Styles>
</Application>
