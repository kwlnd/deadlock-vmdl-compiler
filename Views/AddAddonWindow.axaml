<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DeadlockVmdlCompiler.Views.AddAddonWindow"
        Title="add addon"
        Icon="avares://DeadlockVmdlCompiler/AppIcon.ico"
        Width="520" MinWidth="480"
        SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource StudioWindow}">
    <Window.Styles>
        <Style Selector="AutoCompleteBox#CmbHero /template/ TextBox#PART_TextBox">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Border Classes="studio-card" Margin="12" Padding="16">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="32,10,*">
                <Border Width="32" Height="32" CornerRadius="5"
                        Background="{StaticResource StudioPortrait}" BorderBrush="{StaticResource StudioBorderStrong}"
                        BorderThickness="1" VerticalAlignment="Top">
                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Classes="icon" Data="{StaticResource IconPlus}"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="add addon" FontSize="16" FontWeight="Bold" Foreground="{StaticResource StudioText}"/>
                    <TextBlock Classes="body-copy"
                               Text="Export the main hero model and its dependencies into a new CSDK12 addon."/>
                </StackPanel>
            </Grid>

            <Border Classes="studio-inset" Padding="10,8">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="16,9,*">
                        <Viewbox Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Canvas Width="24" Height="24">
                                <Path Classes="icon" Data="{StaticResource IconLayers}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="2" Classes="body-copy"
                                   Text="Includes cloth_proxy meshes and cloth physics for editing in CSDK12."/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource StudioBorder}"/>
                    <Grid ColumnDefinitions="16,9,*">
                        <Viewbox Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Canvas Width="24" Height="24">
                                <Path Classes="icon" Data="{StaticResource IconAlert}" Classes.warning="True"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="2" Classes="body-copy" Foreground="#FCD99B"
                                   Text="Some cloth nodes may not work correctly after export. Check their behavior before using the addon."/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Height="1" Background="{StaticResource StudioBorder}"/>

            <StackPanel Spacing="5">
                <TextBlock Classes="field-label" Text="character"/>
                <AutoCompleteBox x:Name="CmbHero" Height="40" HorizontalAlignment="Stretch"
                                 Watermark="Select or type a hero"
                                 MinimumPrefixLength="0" MaxDropDownHeight="280"
                                 ValueMemberBinding="{Binding DisplayName}" GotFocus="CmbHero_GotFocus"
                                 SelectionChanged="CmbHero_SelectionChanged" TextChanged="CmbHero_TextChanged">
                    <AutoCompleteBox.InnerLeftContent>
                        <Border x:Name="SelectedHeroPortrait" Width="28" Height="28" Margin="2,0,8,0"
                                CornerRadius="4" ClipToBounds="True" IsVisible="False"
                                Background="{StaticResource StudioPortrait}"
                                BorderBrush="{StaticResource StudioBorderStrong}" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="SelectedHeroFallback" Text="?" FontSize="13" FontWeight="Bold"
                                           Foreground="#93B9EE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="ImgSelectedHero" Stretch="UniformToFill" IsVisible="False"/>
                            </Grid>
                        </Border>
                    </AutoCompleteBox.InnerLeftContent>
                    <AutoCompleteBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="4" ClipToBounds="True"
                                        Background="{StaticResource StudioPortrait}"
                                        BorderBrush="{StaticResource StudioBorderStrong}" BorderThickness="1">
                                    <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="{Binding DisplayName}" Classes="field-label"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>
                <TextBlock Classes="field-hint" Text="Click to browse all heroes, or type a name to filter."/>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Classes="field-label" Text="addon name"/>
                <TextBox x:Name="TxtAddonName" Height="36" Watermark="my_hero_mod"
                         VerticalContentAlignment="Center"/>
                <TextBlock Classes="field-hint"
                           Text="Lowercase letters, digits and underscores; start with a letter."/>
            </StackPanel>

            <TextBlock x:Name="TxtError" IsVisible="False" TextWrapping="Wrap"
                       FontSize="11.5" Foreground="#FCA5A5"/>
            <StackPanel x:Name="PanelProgress" IsVisible="False" Spacing="6">
                <ProgressBar Height="4" IsIndeterminate="True"/>
                <TextBlock x:Name="TxtProgress" Classes="body-copy" Text="Preparing export..."/>
            </StackPanel>

            <Border Height="1" Background="{StaticResource StudioBorder}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="BtnCancel" Content="cancel" MinWidth="86" Height="34"
                        Click="BtnCancel_Click" ToolTip.Tip="Close without creating an addon; stops a running export and removes its files"/>
                <Button x:Name="BtnCreate" Content="create addon" Classes="primary"
                        MinWidth="110" Height="34" Click="BtnCreate_Click" ToolTip.Tip="Export the chosen model with its animations, materials and cloth into the new addon"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
