<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DeadlockVmdlCompiler.Controls"
        xmlns:models="using:DeadlockVmdlCompiler.Models"
        x:Class="DeadlockVmdlCompiler.MainWindow"
        Title="deadlock ag2 compiler"
        Icon="avares://DeadlockVmdlCompiler/AppIcon.ico"
        Width="1100" Height="740" MinWidth="960" MinHeight="620"
        Background="{StaticResource StudioWindow}"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Grid>
    <Grid Margin="14">
        <Grid ColumnDefinitions="430,12,*">
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" Margin="0,0,4,0">

                    <!-- Choose the content that the build operates on. -->
                    <Border Classes="studio-card" Padding="12">
                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconBox}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="MODEL" Classes="section-title"/>
                                    </StackPanel>
                                    <TextBlock Text="choose the addon and target model" Classes="field-hint" Margin="19,0,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnAddAddon" Grid.Column="1" Classes="primary"
                                        Height="32" Padding="10,3" Click="BtnAddAddon_Click" ToolTip.Tip="Export a hero or neutral from the game into a new CSDK12 addon">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconPlus}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="add addon" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Height="1" Background="{StaticResource StudioBorder}"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="addon" Classes="field-label"/>
                                <TextBlock x:Name="LblDiscoveredCount" Grid.Column="1"
                                           Text="scanning..." Classes="field-hint" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,6,84">
                                <ComboBox x:Name="CmbDiscovered" Height="40" HorizontalAlignment="Stretch"
                                          SelectionChanged="CmbDiscovered_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="models:DiscoveredAddon">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Viewbox Width="16" Height="16" Margin="0,0,7,0"
                                                         VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Classes="icon" Data="{StaticResource IconFolder}"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                               FontWeight="SemiBold" Foreground="{StaticResource StudioText}"/>
                                                    <TextBlock Text="{Binding Details}" Classes="field-hint"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Classes="utility" Height="40" HorizontalAlignment="Stretch" Click="Rescan_Click" ToolTip.Tip="Look for addons and models in the CSDK addons folder again">
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconRefresh}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="rescan" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Text="target vmdl" Classes="field-label" Margin="0,4,0,0"/>
                            <Grid ColumnDefinitions="*,6,84">
                                <ComboBox x:Name="CmbTargetVmdl" Height="40" HorizontalAlignment="Stretch"
                                          SelectionChanged="CmbTargetVmdl_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="models:DiscoveredModel">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Classes="icon" Data="{StaticResource IconBox}"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="{Binding Display}" FontSize="11.5"
                                                           Foreground="{StaticResource StudioText}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Classes="utility" Height="40" HorizontalAlignment="Stretch" Click="BrowseFile_Click" ToolTip.Tip="Pick any .vmdl file that is not in the list">
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconFolderOpen}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="browse" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border x:Name="BorderLegacyFrame" Classes="studio-inset" Padding="10,8" IsVisible="False">
                                <Grid ColumnDefinitions="16,9,*,8,Auto">
                                    <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Classes="icon warning" Data="{StaticResource IconAlert}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="body-copy" Foreground="#FCD99B"
                                                   Text="made before the october 2026 update"/>
                                        <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                                   Text="cameras will be misplaced in game until its attachments are synced."/>
                                    </StackPanel>
                                    <Button Grid.Column="4" Classes="utility" Height="28" Content="sync..."
                                            Click="BtnSyncFromGame_Click"
                                            ToolTip.Tip="Open sync from game for this model"/>
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBlock Text="hero / npc preset" Classes="field-label"/>
                                <TextBlock x:Name="LblHeroPathsSource" Grid.Column="1" Text="built-in presets"
                                           Classes="field-hint" VerticalAlignment="Center" MaxWidth="260"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="Skeleton and AnimGraph 2 paths come from this preset list"/>
                            </Grid>
                            <ComboBox x:Name="CmbHeroPreset" Height="40" HorizontalAlignment="Stretch"
                                      SelectionChanged="CmbHeroPreset_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:HeroPresetChoice">
                                        <Grid ColumnDefinitions="26,*" MinHeight="29" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="4"
                                                    Background="{StaticResource StudioPortrait}"
                                                    BorderBrush="{StaticResource StudioBorderStrong}"
                                                    BorderThickness="1" IsVisible="{Binding ShowFallback}">
                                                <TextBlock Text="{Binding FallbackGlyph}" FontSize="13" FontWeight="Bold"
                                                           Foreground="#93B9EE" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="26" Height="26" CornerRadius="4" ClipToBounds="True"
                                                    IsVisible="{Binding HasPortrait}">
                                                <Image Source="{Binding Portrait}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11.5"
                                                           FontWeight="SemiBold" Foreground="{StaticResource StudioText}"/>
                                                <TextBlock Text="{Binding Detail}" Classes="field-hint"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Button x:Name="BtnLoadHeroPaths" Grid.Column="1" Classes="utility" Height="24"
                                        Click="BtnLoadHeroPaths_Click"
                                        ToolTip.Tip="Use your own AG2 preset list (hero_paths.json format)">
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconList}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="load list..." FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnDefaultHeroPaths" Grid.Column="2" Classes="utility" Height="24"
                                        Margin="6,0,0,0"
                                        Click="BtnDefaultHeroPaths_Click" ToolTip.Tip="Return to the built-in AG2 preset list" IsVisible="False">
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconUndo}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="default list" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Primary path: compile, package, then test in game. -->
                    <Border Classes="studio-card" Padding="12">
                        <StackPanel Spacing="9">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Classes="icon" Data="{StaticResource IconPlay}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="BUILD" Classes="section-title"/>
                                </StackPanel>
                                <TextBlock Text="compile the model, then package the addon" Classes="field-hint" Margin="19,0,0,0"/>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource StudioBorder}"/>

                            <Button x:Name="BtnCompile" Classes="primary" Height="48"
                                    HorizontalAlignment="Stretch" Click="BtnCompile_Click" ToolTip.Tip="Inject AG2 nodes, compile in CSWin64 and deploy the model; click again while compiling to cancel">
                                <StackPanel Orientation="Horizontal" Spacing="9"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Classes="icon" Data="{StaticResource IconPlay}" Classes.solid="True"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="TxtCompileBtn" Text="compile model" FontSize="14"
                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <CheckBox x:Name="ChkCompileAllModels" IsVisible="False" Content="compile all models in this addon"
                                      ToolTip.Tip="Compile every model of the addon with its detected hero or npc preset, then offer one VPK"/>

                            <StackPanel x:Name="PanelCompileProgress" IsVisible="False" Spacing="4">
                                <ProgressBar x:Name="PrgCompile" Height="3" Minimum="0" Maximum="100"
                                             Value="0" Foreground="#3B82F6"
                                             Background="{StaticResource StudioPanel}" CornerRadius="1.5"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="LblCompileStage" Text="[1/5] preparing source"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource StudioAccent}"/>
                                        <TextBlock x:Name="LblCompileDetail" Text="starting..." FontSize="9.5"
                                                   Foreground="{StaticResource StudioTextMuted}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LblCompilePercent" Grid.Column="1" Text="0%"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource StudioTextMuted}"/>
                                </Grid>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,8,*">
                                <Button x:Name="BtnMakeVpk" Height="36" HorizontalAlignment="Stretch"
                                        Click="BtnMakeVpk_Click" ToolTip.Tip="Pack the compiled addon into a .vpk after checking its AG2 references">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconArchive}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="TxtMakeVpkBtn" Text="make vpk..." FontSize="11.5"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnLaunchGame" Grid.Column="2" Height="36"
                                        HorizontalAlignment="Stretch" Click="BtnLaunchGame_Click"
                                        ToolTip.Tip="Start Deadlock with this addon loaded (-addon, -allowmultiple)">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconGamepad}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="launch game" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Height="1" Background="{StaticResource StudioBorder}"/>
                            <TextBlock Text="manual tools" Classes="field-hint"/>
                            <Grid ColumnDefinitions="*,8,*,8,*">
                                <Button x:Name="BtnSanitizeModelDoc" Classes="utility tile" Click="BtnSanitizeModelDoc_Click"
                                        ToolTip.Tip="Remove AG2 nodes from the .vmdl so CSDK12 ModelDoc can open it">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <Viewbox Width="14" Height="14" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconWrench}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="TxtSanitizeBtn" Text="fix for modeldoc" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnExportCsWin" Grid.Column="2" Classes="utility tile" Click="BtnExportCsWin_Click"
                                        ToolTip.Tip="Copy the model with AG2 nodes and its meshes to the CSWin64 addon for manual work">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <Viewbox Width="14" Height="14" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconUpload}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="TxtExportCsWinBtn" Text="export to cswin64" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnSyncFromGame" Grid.Column="4" Classes="utility tile" Click="BtnSyncFromGame_Click"
                                        ToolTip.Tip="Update an older .vmdl from the installed game: move camera attachments to the October 2026 frame, add missing attachments and update game data">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <Viewbox Width="14" Height="14" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconRefresh}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="sync from game..." FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="studio-card" Padding="12">
                        <StackPanel Spacing="8">
                            <Button x:Name="BtnToggleAdvanced" Classes="subtle-toggle"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Click="BtnToggleAdvanced_Click" ToolTip.Tip="Paths, AG2 node options and animation handling">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconSliders}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="COMPILER SETTINGS" Classes="section-title"/>
                                    </StackPanel>
                                    <Viewbox Grid.Column="1" Width="12" Height="12" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="IconAdvancedChevron" Classes="icon muted"
                                                  Data="{StaticResource IconChevronDown}"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Button>

                            <StackPanel x:Name="PanelAdvancedContent" IsVisible="False" Spacing="9">
                                <Border Height="1" Background="{StaticResource StudioBorder}"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="cswin64 installation" Classes="field-label"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                        <TextBlock x:Name="LblCsWinStatus" Text="checking..." Classes="field-hint"
                                                   VerticalAlignment="Center"/>
                                        <Border x:Name="BorderCsWinCheck" Width="18" Height="18"
                                                CornerRadius="4" Background="#1D3E2B"
                                                BorderBrush="#22C55E" BorderThickness="1.5">
                                            <Viewbox Width="12" Height="12" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path x:Name="IconCsWinStatus"
                                                          Data="M9 16.2L4.8 12L3.4 13.4L9 19L21 7L19.6 5.6L9 16.2Z"
                                                          Fill="#22C55E"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,6,84">
                                    <TextBox x:Name="TxtCsWinPath" Height="32"
                                             TextChanged="TxtCsWinPath_TextChanged"/>
                                    <Button Grid.Column="2" Classes="utility" Height="32" HorizontalAlignment="Stretch"
                                            Click="BrowseCsWin_Click" ToolTip.Tip="Choose the CSWin64 folder that contains game/bin/win64/resourcecompiler.exe">
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconFolderOpen}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="browse" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="csdk addons folder" Classes="field-label"/>
                                    <TextBlock x:Name="LblCitadelStatus" Grid.Column="1"
                                               Text="checking..." Classes="field-hint"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,6,84">
                                    <TextBox x:Name="TxtCitadelPath" Height="32"
                                             TextChanged="TxtCitadelPath_TextChanged"/>
                                    <Button Grid.Column="2" Classes="utility" Height="32" HorizontalAlignment="Stretch"
                                            Click="BrowseCitadel_Click" ToolTip.Tip="Choose CSDK12 content/citadel_addons">
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconFolderOpen}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="browse" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                </Grid>

                                <Border Height="1" Background="{StaticResource StudioBorder}"/>
                                <TextBlock Text="ag2 nodes" Classes="field-hint"/>
                                <StackPanel Spacing="7">
                                    <StackPanel Spacing="3">
                                        <CheckBox x:Name="ChkSkel" Content="inject nmskeleton" IsChecked="True"/>
                                        <TextBox x:Name="TxtSkel" Height="26" IsReadOnly="True"
                                                 Foreground="{StaticResource StudioTextMuted}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <CheckBox x:Name="ChkGraph" Content="inject animgraph2 (default &amp; named)" IsChecked="True"/>
                                        <TextBox x:Name="TxtGraph" Height="26" IsReadOnly="True"
                                                 Foreground="{StaticResource StudioTextMuted}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <CheckBox x:Name="ChkUiGraph" Content="inject ui animgraph2 (ui)" IsChecked="True"/>
                                        <TextBox x:Name="TxtUiGraph" Height="26" IsReadOnly="True"
                                                 Foreground="{StaticResource StudioTextMuted}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Height="1" Background="{StaticResource StudioBorder}"/>
                                <TextBlock x:Name="LblNamedGraphs" Classes="field-hint" TextWrapping="Wrap" IsVisible="False"/>
                                <CheckBox x:Name="ChkDisableAnimList"
                                          Content="disable animationlist (uncheck to keep animations)"
                                          IsChecked="False"/>
                                <CheckBox x:Name="ChkAutoDetectAnims"
                                          Content="auto-detect animations (disable missing clips)"
                                          IsChecked="True"
                                          ToolTip.Tip="Keeps available animations and skips missing source files. Disable animationlist takes priority."/>
                                <CheckBox x:Name="ChkSkipMaterialCompilation"
                                          Content="skip material/texture compilation (keep csdk materials)"
                                          IsChecked="False"
                                          ToolTip.Tip="Passes -skiptype vmat,vtex to CSWin64 resourcecompiler and temporarily disables missing-material fatal errors in gameinfo.gi. The setting is restored after compilation."/>
                                <CheckBox x:Name="ChkRevert"
                                          Content="revert vmdl back (clean workspace after compile)"
                                          IsChecked="True"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2" RowDefinitions="Auto,6,*,12,Auto,6,176">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Classes="icon" Data="{StaticResource IconLayers}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="PREVIEW" Classes="section-title"/>
                    </StackPanel>
                    <TextBlock x:Name="LblMeshName" Grid.Column="1"
                               Text="mesh: no model selected" Classes="field-hint"
                               MaxWidth="400" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
                <Border Grid.Row="2" Classes="studio-card" Padding="6">
                    <Border Classes="studio-inset" Background="{StaticResource StudioViewport}"
                            ClipToBounds="True">
                        <Grid>
                            <controls:Model3DViewportControl x:Name="ModelViewport"/>
                            <StackPanel x:Name="PanelPreviewEmpty" Spacing="8" IsHitTestVisible="False"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Classes="icon muted" Data="{StaticResource IconBox}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="TxtPreviewEmpty" Text="no model selected" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{StaticResource StudioTextSoft}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPreviewEmptyHint" Classes="field-hint" TextAlignment="Center"
                                           HorizontalAlignment="Center" MaxWidth="300" TextWrapping="Wrap"
                                           Text="pick an addon and a target vmdl on the left, or drop a .vmdl file or an addon folder on this window."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Classes="icon" Data="{StaticResource IconList}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="LOG" Classes="section-title"/>
                    </StackPanel>
                    <Button x:Name="BtnClearLog" Grid.Column="1" Classes="utility" Height="25"
                            Padding="7,1" Margin="0,0,6,0"
                            Click="BtnClearLog_Click" ToolTip.Tip="Clear the log console">
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconTrash}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="clear" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                    <Button x:Name="BtnCopyLog" Grid.Column="2" Classes="utility" Height="25"
                            Padding="7,1" Margin="0,0,10,0"
                            Click="BtnCopyLog_Click" ToolTip.Tip="Copy the whole log to the clipboard">
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="icon" Data="{StaticResource IconCopy}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="copy" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                    <CheckBox x:Name="ChkAutoScroll" Grid.Column="3" Content="auto-scroll"
                              IsChecked="True" VerticalAlignment="Center"/>
                </Grid>
                <Border Grid.Row="6" Classes="studio-card" Padding="5">
                    <Border Classes="studio-inset" Background="{StaticResource StudioViewport}">
                        <ScrollViewer x:Name="ScrollLog">
                            <SelectableTextBlock x:Name="TxtLog" Foreground="{StaticResource StudioText}"
                                                 FontFamily="Consolas,Cascadia Code,Monospace" FontSize="11.5"
                                                 TextWrapping="Wrap" Padding="8,6" LineHeight="17"/>
                        </ScrollViewer>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>

        <!-- Shown while a file or folder is dragged over the window. -->
        <Border x:Name="BorderDropOverlay" IsVisible="False" IsHitTestVisible="False"
                Background="#CC0E1219" BorderBrush="{StaticResource StudioAccent}" BorderThickness="2"
                CornerRadius="8" Margin="8">
            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="32" Height="32" HorizontalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Classes="icon" Data="{StaticResource IconFolderOpen}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="drop a .vmdl or an addon folder" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource StudioText}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
