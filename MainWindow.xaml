<Window x:Class="DeadlockVmdlCompiler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="deadlock ag2 compiler"
        Icon="AppIcon.ico"
        Width="960"
        MinWidth="920"
        MinHeight="460"
        SizeToContent="Height"
        Background="{StaticResource AppBg}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Two-Column Workspace -->
            <RowDefinition Height="Auto"/> <!-- 1. Advanced Expander (under Workspace) -->
        </Grid.RowDefinitions>

        <!-- 0. Two-Column Workspace Grid (Left Panel & 3D Preview aligned) -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/> <!-- Left Column: 60% -->
                <ColumnDefinition Width="10"/> <!-- Gap -->
                <ColumnDefinition Width="4*"/> <!-- Right Column: 40% -->
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- LEFT PANEL: Model Selection & Presets + Compile Button  -->
            <!-- ======================================================== -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                    <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M4 6H20V18H4V6ZM2 4C2 2.9 2.9 2 4 2H20C21.1 2 22 2.9 22 4V20C22 21.1 21.1 22 20 22H4C2.9 22 2 21.1 2 20V4Z" Fill="#619BF2"/>
                            <Path Data="M7 10H17V12H7V10ZM7 14H14V16H7V14Z" Fill="#D9E7FF"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="model selection &amp; presets" Style="{StaticResource SectionHeader}" Margin="0"/>
                </StackPanel>

                <!-- Model Selection Card (4 Rows) -->
                <Border Style="{StaticResource StudioCard}" Margin="0,0,0,6">
                    <StackPanel>
                        <!-- Row 1: Discovered Hero Models / Addon -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="discovered addon:" Style="{StaticResource ItemTitle}"/>
                                <TextBlock x:Name="LblDiscoveredCount" Text="scanning..." Style="{StaticResource ItemDesc}"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbDiscovered"
                                      Grid.Column="1"
                                      Margin="6,0"
                                      Height="36"
                                      VerticalAlignment="Center"
                                      SelectionChanged="CmbDiscovered_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1,0,1">
                                            <!-- Placeholder text (single line) -->
                                            <TextBlock Text="{Binding Display}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Real Addon: Flat VPK Icon + Addon Name + Hero Summary -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Official VRF Vector Folder Icon with VPK Cutout -->
                                                <Viewbox Grid.Column="0" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <!-- Folder Back Tab -->
                                                        <Path Data="M2 7C2 5.89543 2.89543 5 4 5H10.2268C10.7243 5 11.204 5.18544 11.5721 5.52012L16.5 10H2V7Z" Fill="#458FFF"/>
                                                        <Path Data="M2 9C2 7.89543 2.89543 7 4 7H20C21.1046 7 22 7.89543 22 9V11H2V9Z" Fill="#313F59"/>
                                                        <!-- Folder Front Body with VPK Cutout -->
                                                        <Path Data="M4 8H20C21.1046 8 22 8.89543 22 10V17C22 18.1046 21.1046 19 20 19H4C2.89543 19 2 18.1046 2 17V10C2 8.89543 2.89543 8 4 8ZM4.97363 12L6.2168 15.3643L7.49609 12H9.10156L7.01074 17.5H5.40918L3.375 12H4.97363ZM10 12V17.5H11.5V16.25H12.125C13.2985 16.25 14.2499 15.2985 14.25 14.125C14.2499 12.9515 13.2985 12 12.125 12H10ZM11.5 13.5H12.125C12.4701 13.5 12.7499 13.7799 12.75 14.125C12.7499 14.4701 12.4701 14.75 12.125 14.75H11.5V13.5ZM16.75 12V13.8271L17.8584 12.4961L20.0986 12.1514L17.96 14.7178L20.1006 17.5H18.208L16.9766 15.8984L16.75 16.1709V17.5H15.25V12H16.75Z" Fill="#458FFF"/>
                                                    </Canvas>
                                                </Viewbox>

                                                <!-- Two Rows: Top = Addon Name (+ Hero), Bottom = Details -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                        <TextBlock Text=" · " Foreground="{StaticResource TextDisabled}" Margin="3,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasHero}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding HeroSummary}" FontSize="11" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasHero}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Details}" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="2" Style="{StaticResource StudioSecBtn}" Height="36" Padding="8,2" Click="Rescan_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="12" Height="12" Margin="0,0,5,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M12 4V1L7 6L12 11V7C15.31 7 18 9.69 18 13C18 16.31 15.31 19 12 19C8.69 19 6 16.31 6 13H4C4 17.42 7.58 21 12 21C16.42 21 20 17.42 20 13C20 8.58 16.42 5 12 4Z" Fill="#619BF2"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="rescan"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{StaticResource RowDivider}" Margin="0,6"/>

                        <!-- Row 2: Target VMDL File (Scoped to selected Addon + Manual choice) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="target vmdl file:" Style="{StaticResource ItemTitle}"/>
                                <TextBlock Text="direct path in addon" Style="{StaticResource ItemDesc}"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbTargetVmdl"
                                      Grid.Column="1"
                                      Height="26"
                                      Margin="6,0"
                                      VerticalAlignment="Center"
                                      SelectionChanged="CmbTargetVmdl_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- S2V / VRF 3D Wireframe VMDL Model Icon -->
                                            <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <!-- Top Face -->
                                                    <Polygon Points="12,2 22,7.5 12,13 2,7.5" Fill="#458FFF" Opacity="0.9"/>
                                                    <!-- Left Face -->
                                                    <Polygon Points="2,7.5 12,13 12,22 2,16.5" Fill="#2B6CD4" Opacity="0.95"/>
                                                    <!-- Right Face -->
                                                    <Polygon Points="12,13 22,7.5 22,16.5 12,22" Fill="#1E4FA0"/>
                                                    <!-- Wireframe Edges / Subdivisions -->
                                                    <Line X1="12" Y1="2" X2="12" Y2="13" Stroke="#87B4F9" StrokeThickness="1"/>
                                                    <Line X1="2" Y1="7.5" X2="22" Y2="7.5" Stroke="#87B4F9" StrokeThickness="1"/>
                                                    <Line X1="12" Y1="13" X2="12" Y2="22" Stroke="#87B4F9" StrokeThickness="1"/>
                                                    <Line X1="2" Y1="7.5" X2="12" Y2="22" Stroke="#619BF2" StrokeThickness="0.8" StrokeDashArray="1,1"/>
                                                    <Line X1="22" Y1="7.5" X2="12" Y2="22" Stroke="#619BF2" StrokeThickness="0.8" StrokeDashArray="1,1"/>
                                                    <!-- Outer Wireframe Boundary -->
                                                    <Polygon Points="12,2 22,7.5 22,16.5 12,22 2,16.5 2,7.5" Stroke="#D9E7FF" StrokeThickness="1.2"/>
                                                    <!-- 3D Vertex Dots (Source 2 Model Nodes) -->
                                                    <Ellipse Margin="10.75,0.75,0,0" Width="2.5" Height="2.5" Fill="#FFFFFF"/>
                                                    <Ellipse Margin="0.75,6.25,0,0" Width="2.5" Height="2.5" Fill="#FFFFFF"/>
                                                    <Ellipse Margin="20.75,6.25,0,0" Width="2.5" Height="2.5" Fill="#FFFFFF"/>
                                                    <Ellipse Margin="10.75,11.75,0,0" Width="2.5" Height="2.5" Fill="#FFFFFF"/>
                                                    <Ellipse Margin="0.75,15.25,0,0" Width="2.5" Height="2.5" Fill="#FFFFFF"/>
                                                    <Ellipse Margin="20.75,15.25,0,0" Width="2.5" Height="2.5" Fill="#FFFFFF"/>
                                                    <Ellipse Margin="10.75,20.75,0,0" Width="2.5" Height="2.5" Fill="#FFFFFF"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextPrimary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="2" Style="{StaticResource StudioSecBtn}" Height="26" Padding="8,2" Click="BrowseFile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <!-- S2V / VRF 3D Wireframe VMDL Model Icon -->
                                    <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                                        <Canvas Width="24" Height="24">
                                            <Polygon Points="12,2 22,7.5 12,13 2,7.5" Fill="#458FFF" Opacity="0.9"/>
                                            <Polygon Points="2,7.5 12,13 12,22 2,16.5" Fill="#2B6CD4" Opacity="0.95"/>
                                            <Polygon Points="12,13 22,7.5 22,16.5 12,22" Fill="#1E4FA0"/>
                                            <Line X1="12" Y1="2" X2="12" Y2="13" Stroke="#87B4F9" StrokeThickness="1"/>
                                            <Line X1="2" Y1="7.5" X2="22" Y2="7.5" Stroke="#87B4F9" StrokeThickness="1"/>
                                            <Line X1="12" Y1="13" X2="12" Y2="22" Stroke="#87B4F9" StrokeThickness="1"/>
                                            <Polygon Points="12,2 22,7.5 22,16.5 12,22 2,16.5 2,7.5" Stroke="#D9E7FF" StrokeThickness="1.2"/>
                                            <Ellipse Margin="10.75,0.75,0,0" Width="2.5" Height="2.5" Fill="#FFFFFF"/>
                                            <Ellipse Margin="0.75,6.25,0,0" Width="2.5" Height="2.5" Fill="#FFFFFF"/>
                                            <Ellipse Margin="20.75,6.25,0,0" Width="2.5" Height="2.5" Fill="#FFFFFF"/>
                                            <Ellipse Margin="10.75,11.75,0,0" Width="2.5" Height="2.5" Fill="#FFFFFF"/>
                                            <Ellipse Margin="0.75,15.25,0,0" Width="2.5" Height="2.5" Fill="#FFFFFF"/>
                                            <Ellipse Margin="20.75,15.25,0,0" Width="2.5" Height="2.5" Fill="#FFFFFF"/>
                                            <Ellipse Margin="10.75,20.75,0,0" Width="2.5" Height="2.5" Fill="#FFFFFF"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="browse..."/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{StaticResource RowDivider}" Margin="0,6"/>

                        <!-- Row 3: Hero Preset -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="hero preset:" Style="{StaticResource ItemTitle}"/>
                                <TextBlock Text="skeleton &amp; animgraph" Style="{StaticResource ItemDesc}"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbHeroPreset" Grid.Column="1" Height="26" Margin="6,0,0,0" VerticalAlignment="Center" SelectionChanged="CmbHeroPreset_SelectionChanged"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource RowDivider}" Margin="0,6"/>

                        <!-- Row 4: Action Tools Grid (2 structured rows for perfect fit) -->
                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 1, Col 0: restore ag2 list -->
                            <Button x:Name="BtnRestorePresets" Grid.Row="0" Grid.Column="0" Style="{StaticResource StudioSecBtn}" Height="25" Margin="0,0,3,4" Click="BtnRestorePresets_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Viewbox Width="11" Height="11" Margin="0,0,4,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M12 5V1L7 6L12 11V7C15.31 7 18 9.69 18 13C18 14.01 17.75 14.97 17.3 15.8L18.8 17.3C19.55 16.05 20 14.58 20 13C20 8.58 16.42 5 12 5ZM6.7 8.2L5.2 6.7C4.45 7.95 4 9.42 4 11C4 15.42 7.58 19 12 19V23L17 18L12 13V17C8.69 17 6 14.31 6 11C6 9.99 6.25 9.03 6.7 8.2Z" Fill="#87B4F9"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="TxtRestoreBtn" Text="restore ag2 list" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- Row 1, Col 1: get ag2 lists -->
                            <Button x:Name="BtnUpdateVpkPresets" Grid.Row="0" Grid.Column="1" Style="{StaticResource StudioSecBtn}" Height="25" Margin="3,0,3,4" Click="BtnUpdateVpkPresets_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Viewbox Width="11" Height="11" Margin="0,0,4,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M19 11C19 15.42 15.42 19 11 19C6.58 19 3 15.42 3 11C3 6.58 6.58 3 11 3C15.42 3 19 6.58 19 11Z" Fill="#87B4F9"/>
                                            <Path Data="M17 11C17 14.31 14.31 17 11 17C7.69 17 5 14.31 5 11C5 7.69 7.69 5 11 5C14.31 5 17 7.69 17 11Z" Fill="#D9E7FF"/>
                                            <Path Data="M14 14L20 20" Stroke="#4666A6" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="TxtGetListsBtn" Text="get ag2 lists" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- Row 1, Col 2: fix for modeldoc -->
                            <Button x:Name="BtnSanitizeModelDoc" Grid.Row="0" Grid.Column="2" Style="{StaticResource StudioSecBtn}" Height="25" Margin="3,0,0,4" Click="BtnSanitizeModelDoc_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Viewbox Width="11" Height="11" Margin="0,0,4,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M19.36 10.04L18 8.68L12.93 13.76C12.8 13.88 12.63 13.96 12.44 13.96C12.06 13.96 11.75 13.65 11.75 13.27C11.75 13.08 11.83 12.92 11.95 12.79L17.03 7.72L15.68 6.36C15.39 6.07 14.91 6.07 14.62 6.36L8.41 12.57L9.83 13.99L8.41 15.41L7 13.99L4.17 16.82C3.39 17.6 3.39 18.87 4.17 19.65C4.95 20.43 6.22 20.43 7 19.65L9.83 16.82L8.41 15.41L9.83 13.99L11.24 15.41L17.45 9.2C17.74 8.91 17.74 8.43 17.45 8.14" Fill="#87B4F9"/>
                                            <Path Data="M19.36 10.04C19.65 9.75 19.65 9.27 19.36 8.98L17.02 6.64C16.73 6.35 16.25 6.35 15.96 6.64L14.62 7.98L17.98 11.34L19.36 10.04Z" Fill="#D9E7FF"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="TxtSanitizeBtn" Text="fix for modeldoc" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- Row 2: transfer cloth, make vpk & export to cswin64 -->
                            <Grid Grid.Row="1" Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- transfer hero cloth -->
                                <Button x:Name="BtnTransferCloth" Grid.Column="0" Style="{StaticResource StudioSecBtn}" Height="25" Margin="0,0,3,0" Click="BtnTransferCloth_Click" ToolTip="Transfer original Cloth Chains &amp; Colliders from game/reference">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Viewbox Width="12" Height="12" Margin="0,0,4,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20ZM11 7H13V13H11V7ZM11 15H13V17H11V15Z" Fill="#87B4F9"/>
                                                <Path Data="M16 6C13.5 8 10.5 8 8 6M16 18C13.5 16 10.5 16 8 18M18 8C16 10.5 16 13.5 18 16M6 8C8 10.5 8 13.5 6 16" Stroke="#87B4F9" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="TxtTransferClothBtn" Text="transfer cloth" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>

                                <!-- make vpk... -->
                                <Button x:Name="BtnMakeVpk" Grid.Column="1" Style="{StaticResource StudioSecBtn}" Height="25" Margin="3,0,3,0" Click="BtnMakeVpk_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Viewbox Width="12" Height="12" Margin="0,0,4,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M2 7C2 5.89 2.89 5 4 5H10.22L16.5 10H2V7Z" Fill="#458FFF"/>
                                                <Path Data="M4 8H20C21.1 8 22 8.89 22 10V17C22 18.1 21.1 19 20 19H4C2.89 19 2 18.1 2 17V10C2 8.89 2.89 8 4 8Z" Fill="#313F59"/>
                                                <Path Data="M12 11V16M12 16L14.5 13.5M12 16L9.5 13.5" Stroke="#87B4F9" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="TxtMakeVpkBtn" Text="make vpk..." FontSize="11"/>
                                    </StackPanel>
                                </Button>

                                <!-- export to cswin64 -->
                                <Button x:Name="BtnExportCsWin" Grid.Column="2" Style="{StaticResource StudioSecBtn}" Height="25" Margin="3,0,0,0" Click="BtnExportCsWin_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Viewbox Width="12" Height="12" Margin="0,0,4,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M12 4V15.5M12 15.5L16 11.5M12 15.5L8 11.5M7 20H17" Stroke="#87B4F9" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="TxtExportCsWinBtn" Text="export to cswin64" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Main Action Button: Compile -->
                <Button x:Name="BtnCompile" Style="{StaticResource StudioPrimaryBtn}" Height="32" Click="BtnCompile_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 7 4.5 C 7 3.6 8 3.1 8.8 3.6 L 19.8 10.6 C 20.5 11.1 20.5 12.1 19.8 12.6 L 8.8 19.6 C 8 20.1 7 19.6 7 18.7 Z" Fill="#FFFFFF"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="TxtCompileBtn" Text="compile" FontWeight="Bold" FontSize="12.5"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ======================================================== -->
            <!-- RIGHT PANEL: Preview Box (40%)                          -->
            <!-- ======================================================== -->
            <StackPanel Grid.Column="2">
                <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                    <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12 2L2 7L12 12L22 7L12 2ZM2 17L12 22L22 17M2 12L12 17L22 12" Stroke="#87B4F9" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="3d preview" Style="{StaticResource SectionHeader}" Margin="0"/>
                </StackPanel>
                <Border Style="{StaticResource StudioCard}" Padding="6">
                    <StackPanel>
                        <!-- 3D Canvas / Viewport Box -->
                        <Border Background="{StaticResource ViewportBg}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="2" Height="228" ClipToBounds="True">
                            <Viewport3D x:Name="ModelViewport"
                                        MouseDown="Viewport_MouseDown"
                                        MouseMove="Viewport_MouseMove"
                                        MouseUp="Viewport_MouseUp"
                                        MouseWheel="Viewport_MouseWheel"
                                        Cursor="Hand">
                                <Viewport3D.Camera>
                                    <PerspectiveCamera x:Name="ViewCamera"
                                                       Position="-4.2,1.2,0"
                                                       LookDirection="1,-0.1,0"
                                                       UpDirection="0,1,0"
                                                       FieldOfView="48"/>
                                </Viewport3D.Camera>
                                <ModelVisual3D x:Name="SceneVisual"/>
                            </Viewport3D>
                        </Border>

                        <!-- Info Label Below Viewport: DMX name -->
                        <TextBlock x:Name="LblMeshName" Text="mesh: no model selected" Style="{StaticResource ItemDesc}" FontSize="11" Margin="2,6,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 1. ADVANCED EXPANDER (CONTAINING ENVIRONMENT, INJECTIONS & LOG CONSOLE) -->
        <Expander x:Name="ExpanderAdvanced" Grid.Row="1" Header="advanced settings &amp; tools" IsExpanded="False" Margin="0,2,0,0">
            <Border Style="{StaticResource StudioCard}" Margin="0,4,0,0" Padding="10">
                <StackPanel>
                    <!-- 1. ENVIRONMENT PATHS CARD (Topology indented under Header) -->
                    <StackPanel Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                            <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M19.14 12.94C19.18 12.63 19.2 12.32 19.2 12C19.2 11.68 19.18 11.37 19.14 11.06L21.16 9.48C21.34 9.34 21.39 9.08 21.28 8.88L19.36 5.56C19.25 5.36 19 5.28 18.79 5.36L16.42 6.32C15.93 5.94 15.39 5.63 14.81 5.39L14.45 2.87C14.42 2.64 14.22 2.47 13.99 2.47H10.15C9.92 2.47 9.72 2.64 9.69 2.87L9.33 5.39C8.75 5.63 8.21 5.94 7.72 6.32L5.35 5.36C5.14 5.28 4.89 5.36 4.78 5.56L2.86 8.88C2.75 9.08 2.8 9.34 2.98 9.48L5 11.06C4.96 11.37 4.94 11.68 4.94 12C4.94 12.32 4.96 12.63 5 12.94L2.98 14.52C2.8 14.66 2.75 14.92 2.86 15.12L4.78 18.44C4.89 18.64 5.14 18.72 5.35 18.64L7.72 17.68C8.21 18.06 8.75 18.37 9.33 18.61L9.69 21.13C9.72 21.36 9.92 21.53 10.15 21.53H13.99C14.22 21.53 14.42 21.36 14.45 21.13L14.81 18.61C15.39 18.37 15.93 18.06 16.42 17.68L18.79 18.64C19 18.72 19.25 18.64 19.36 18.44L21.28 15.12C21.39 14.92 21.34 14.66 21.16 14.52L19.14 12.94ZM12 15.5C10.07 15.5 8.5 13.93 8.5 12C8.5 10.07 10.07 8.5 12 8.5C13.93 8.5 15.5 10.07 15.5 12C15.5 13.93 13.93 15.5 12 15.5Z" Fill="#619BF2"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="environment paths" Style="{StaticResource SectionHeader}" Margin="0"/>
                        </StackPanel>

                        <!-- CSWin64 Row with Status Checkmark (Indented) -->
                        <Grid Margin="18,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="cswin64 installation:" Style="{StaticResource ItemTitle}"/>
                                <TextBlock x:Name="LblCsWinStatus" Text="checking..." Style="{StaticResource ItemDesc}"/>
                            </StackPanel>
                            <TextBox x:Name="TxtCsWinPath" Grid.Column="1" Height="26" Margin="6,0" VerticalAlignment="Center" TextChanged="TxtCsWinPath_TextChanged"/>
                            
                            <!-- Visual Checkmark / Error Icon for CSWin64 (Bold & Prominent) -->
                            <Border x:Name="BorderCsWinCheck" Grid.Column="2" Width="22" Height="22" Margin="0,0,6,0" VerticalAlignment="Center" CornerRadius="4" Background="#1D3E2B" BorderBrush="#22C55E" BorderThickness="1.5">
                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="IconCsWinStatus" Data="M9 16.2L4.8 12L3.4 13.4L9 19L21 7L19.6 5.6L9 16.2Z" Fill="#22C55E"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <Button Grid.Column="3" Style="{StaticResource StudioSecBtn}" Height="26" Padding="8,2" Click="BrowseCsWin_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M2 7C2 5.89 2.89 5 4 5H10.22C10.72 5 11.2 5.18 11.57 5.52L16.5 10H2V7Z" Fill="#458FFF"/>
                                            <Path Data="M2 9C2 7.89 2.89 7 4 7H20C21.1 7 22 7.89 22 9V11H2V9Z" Fill="#313F59"/>
                                            <Path Data="M2 8H22V17C22 18.1 21.1 19 20 19H4C2.89 19 2 18.1 2 17V8Z" Fill="#3E547E"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="browse..."/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- CSDK Addons Row (Indented) -->
                        <Grid Margin="18,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="csdk addons folder:" Style="{StaticResource ItemTitle}"/>
                                <TextBlock x:Name="LblCitadelStatus" Text="checking..." Style="{StaticResource ItemDesc}"/>
                            </StackPanel>
                            <TextBox x:Name="TxtCitadelPath" Grid.Column="1" Height="26" Margin="6,0" VerticalAlignment="Center" TextChanged="TxtCitadelPath_TextChanged"/>
                            <Button Grid.Column="2" Style="{StaticResource StudioSecBtn}" Height="26" Padding="8,2" Click="BrowseCitadel_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M2 7C2 5.89 2.89 5 4 5H10.22C10.72 5 11.2 5.18 11.57 5.52L16.5 10H2V7Z" Fill="#458FFF"/>
                                            <Path Data="M2 9C2 7.89 2.89 7 4 7H20C21.1 7 22 7.89 22 9V11H2V9Z" Fill="#313F59"/>
                                            <Path Data="M2 8H22V17C22 18.1 21.1 19 20 19H4C2.89 19 2 18.1 2 17V8Z" Fill="#3E547E"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="browse..."/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource RowDivider}" Margin="0,4,0,6"/>

                    <!-- 2. INJECTION ROWS & REVERT CHECKBOX (Indented Topology) -->
                    <Grid Margin="18,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="195"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: NmSkeleton -->
                        <CheckBox x:Name="ChkSkel" Grid.Row="0" Grid.Column="0" Content="inject nmskeleton" IsChecked="True" VerticalAlignment="Center" Checked="OptionChanged" Unchecked="OptionChanged"/>
                        <TextBox x:Name="TxtCustomSkel" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,2" VerticalAlignment="Center"/>

                        <!-- Row 1: DefaultAnimGraph2 -->
                        <CheckBox x:Name="ChkGraph" Grid.Row="1" Grid.Column="0" Content="inject defaultanimgraph2" IsChecked="True" VerticalAlignment="Center" Checked="OptionChanged" Unchecked="OptionChanged"/>
                        <TextBox x:Name="TxtCustomGraph" Grid.Row="1" Grid.Column="1" Height="26" Margin="0,2" VerticalAlignment="Center"/>

                        <!-- Row 2: UI AnimGraph2 -->
                        <CheckBox x:Name="ChkUiGraph" Grid.Row="2" Grid.Column="0" Content="inject ui animgraph2 (ui)" IsChecked="True" VerticalAlignment="Center" Checked="OptionChanged" Unchecked="OptionChanged"/>
                        <TextBox x:Name="TxtCustomUiGraph" Grid.Row="2" Grid.Column="1" Height="26" Margin="0,2" VerticalAlignment="Center"/>

                        <!-- Row 3: Revert VMDL back -->
                        <CheckBox x:Name="ChkRevert" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,2" Content="revert vmdl back (clean workspace after compile)" IsChecked="True" VerticalAlignment="Center" Checked="OptionChanged" Unchecked="OptionChanged"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource RowDivider}" Margin="0,6"/>

                    <!-- 3. LOG CONSOLE (Indented Topology) -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M4 4H20V20H4V4ZM6 7H18V9H6V7ZM6 11H18V13H6V11ZM6 15H14V17H6V15Z" Fill="#619BF2"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="log console" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkAutoScroll" Grid.Column="2" Content="auto-scroll" IsChecked="True" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Embedded Log Console Text Area (Indented to match rows) -->
                    <TextBox x:Name="TxtLog"
                             Height="140"
                             Margin="18,2,0,0"
                             Background="{StaticResource ViewportBg}"
                             Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource CardBorder}"
                             BorderThickness="1"
                             FontFamily="{StaticResource CodeFont}"
                             FontSize="11"
                             IsReadOnly="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             Padding="8,6"
                             AcceptsReturn="True"/>
                </StackPanel>
            </Border>
        </Expander>
    </Grid>
</Window>
